# HTTP server
PORT=3333
CORS_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=please-change-this-in-prod

# PostgreSQL connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pethelp

# Used by node-pg-migrate (pnpm migrate up). Keep it in sync with the values
# above, or point it at a different database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pethelp
